{
  "name": "@wavecast/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma generate && tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e src/tests/.env.test -- vitest run",
    "test:watch": "dotenv -e src/tests/.env.test -- vitest",
    "test:coverage": "dotenv -e src/tests/.env.test -- vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/nodemailer": "^8.0.0",
    "@wavecast/shared": "*",
    "axios": "^1.7.0",
    "bcrypt": "^5.1.0",
    "bottleneck": "^2.19.0",
    "cookie-parser": "^1.4.0",
    "cors": "^2.8.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^3.0.0",
    "nodemailer": "^8.0.7",
    "openai": "^4.77.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.0",
    "dotenv": "^16.0.0",
    "dotenv-cli": "^7.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}
