generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  createdAt    DateTime   @default(now()) @map("created_at")

  favorites    Favorite[]
  alerts       Alert[]

  @@map("users")
}

// ─── Surf Spot ───────────────────────────────────────────────────────────────

model Spot {
  id        String     @id @default(uuid())
  name      String
  lat       Float
  lng       Float
  country   String
  region    String
  createdAt DateTime   @default(now()) @map("created_at")

  favorites Favorite[]
  cache     ForecastCache[]

  @@map("spots")
}

// ─── Forecast Cache (TTL = 3 hours) ──────────────────────────────────────────

model ForecastCache {
  id        String   @id @default(uuid())
  spotId    String   @map("spot_id")
  provider  String
  data      Json
  fetchedAt DateTime @default(now()) @map("fetched_at")

  spot      Spot     @relation(fields: [spotId], references: [id])

  @@unique([spotId, provider])
  @@index([fetchedAt])
  @@map("forecast_cache")
}

// ─── Favorites ───────────────────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  spotId    String   @map("spot_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])
  spot      Spot     @relation(fields: [spotId], references: [id])

  @@unique([userId, spotId])
  @@map("favorites")
}

// ─── Alerts (Email notifications via SendGrid) ───────────────────────────────

model Alert {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  spotId     String    @map("spot_id")
  minScore   Int       @map("min_score")
  timePref   String    @map("time_pref") // "dawn" | "morning" | "any"
  active     Boolean   @default(true)
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id])

  @@map("alerts")
}
